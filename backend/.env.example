DEBUG=true
CORS_ORIGINS=["http://localhost:3000"]

# IBM Watsonx credentials (required by agents.py — investigator + documenter LLMs)
WATSONX_URL=https://us-south.ml.cloud.ibm.com
WATSONX_APIKEY=your-ibm-cloud-api-key
WATSONX_PROJECT_ID=your-watsonx-project-id

# IBM Bob AI handoff (required by fixer_agent)
# Full URL of the IBM Bob App webhook that accepts the fix-request payload.
# Falls back to state["callback_url"] when not set.
BOB_WEBHOOK_URL=https://your-bob-app.example.com/webhook/fix

# GitHub token used by fixer_agent to post the @ibm-bob PR comment.
# In a GitHub Actions workflow this is automatically available as:
#   GITHUB_TOKEN: ${{ secrets.GITHUB_TOKEN }}
GITHUB_TOKEN=your-github-personal-access-token

# Optional: override for GitHub Enterprise Server
# GITHUB_API_URL=https://github.your-company.com/api/v3
