DEBUG=true
CORS_ORIGINS=["http://localhost:3000"]
DATABASE_URL=postgresql://postgres:postgres@localhost:55432/flaky_debug

# GitHub App (Settings → Developer settings → GitHub Apps)
# Permissions: Actions read & write, Contents read, Metadata read. Subscribe to "Workflow run".
GITHUB_APP_ID=
# Either point at the downloaded .pem file, or paste the PEM into GITHUB_APP_PRIVATE_KEY.
GITHUB_APP_PRIVATE_KEY_PATH=./github-app.pem
GITHUB_WEBHOOK_SECRET=

# Workflow names whose failures trigger a flaky rerun. Empty list = every workflow.
WATCHED_WORKFLOWS=["CI"]
RERUN_WORKFLOW_FILE=flaky-rerun.yml
RERUN_WORKFLOW_NAME=Flaky Rerun
RERUN_ATTEMPTS=10
