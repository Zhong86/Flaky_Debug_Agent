DEBUG=true
CORS_ORIGINS=["http://localhost:3000"]
DATABASE_URL=postgresql://postgres:postgres@localhost:55432/flaky_debug

# Used both by the API (clone/dispatch/rerun) and by agents.py's fixer_agent
# to push its fix branch. A PAT with repo/actions scope works; in a GitHub
# Actions workflow this is automatically available as secrets.GITHUB_TOKEN.
GITHUB_TOKEN=
GITHUB_API_BASE=https://api.github.com

# Secret of the repo webhook (Settings → Webhooks) that points at /api/webhooks/github.
GITHUB_WEBHOOK_SECRET=
# Workflow names whose failures trigger a flaky rerun. Empty list = every workflow.
WATCHED_WORKFLOWS=[]
# Parallel attempts per flaky-rerun.yml dispatch.
RERUN_ATTEMPTS=5

# IBM Bob CLI (bob run) -- used by agents.py's investigator/fixer/documenter
# agents. Generate a key with "Inference" scope from the Bob web portal.
BOB_API_KEY=
# Only required for general-type API keys (see bob.ibm.com/docs/shell).
BOB_TEAM_ID=
