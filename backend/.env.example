DEBUG=true
CORS_ORIGINS=["http://localhost:3000"]
DATABASE_URL=postgresql://postgres:postgres@localhost:55432/flaky_debug

# Fallback auth: used when no GitHub App below is configured, and for calls that
# have no installation context (the JUnit ingest endpoint). A PAT with repo/actions
# scope works; in a GitHub Actions workflow this is automatically available as
# secrets.GITHUB_TOKEN.
GITHUB_TOKEN=
GITHUB_API_BASE=https://api.github.com

# GitHub App (preferred over the PAT above — see README's "GitHub integration"
# section for how to create one). Every webhook delivery carries the installing
# repo's installation.id, so one App can serve many repos without a PAT each.
GITHUB_APP_ID=
# Either the PEM contents directly, or GITHUB_APP_PRIVATE_KEY_PATH pointing at
# the .pem file GitHub gives you when you generate a private key for the App.
GITHUB_APP_PRIVATE_KEY=
GITHUB_APP_PRIVATE_KEY_PATH=

# Secret of the App's webhook (or the repo webhook, if not using a GitHub App)
# that points at /api/webhooks/github.
GITHUB_WEBHOOK_SECRET=
# Workflow names whose failures trigger a flaky rerun. Empty list = every workflow.
WATCHED_WORKFLOWS=[]
# Parallel attempts per flaky-rerun.yml dispatch.
RERUN_ATTEMPTS=5

# IBM Bob CLI (bob run) -- used by agents.py's investigator/fixer/documenter
# agents. Generate a key with "Inference" scope from the Bob web portal.
BOB_API_KEY=
# Only required for general-type API keys (see bob.ibm.com/docs/shell).
BOB_TEAM_ID=
