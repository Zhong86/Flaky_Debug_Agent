# Copy to deploy/.env and fill in (deploy/.env is git-ignored).
# Used both by docker compose and as the backend's environment.

# --- Public URL (ngrok) ---
# dashboard.ngrok.com → "Your Authtoken", and → "Domains" for your free static domain.
NGROK_AUTHTOKEN=
NGROK_DOMAIN=your-name.ngrok-free.app

# --- Database (only reachable inside the compose network) ---
# Letters and digits only: it goes into a connection URL.
POSTGRES_PASSWORD=change-me

# --- GitHub: the watched demo repo ---
# Fine-grained PAT, repository access = the demo repo only, with
#   Actions: read & write, Contents: read & write, Metadata: read.
# Leave unset if you're using a GitHub App instead (see the two vars below and
# the repo root README's "GitHub integration" section for how to create one).
GITHUB_TOKEN=
# Same value as the secret of the demo repo's webhook (or the App's webhook).
GITHUB_WEBHOOK_SECRET=
# GitHub App, as an alternative to GITHUB_TOKEN above.
GITHUB_APP_ID=
# The .pem's contents on one line (\n for newlines) — there's no volume mount for
# a key file here, so GITHUB_APP_PRIVATE_KEY_PATH doesn't work under Compose.
GITHUB_APP_PRIVATE_KEY=
# Workflow names whose failures start a flaky rerun (the demo's deploy.yml is "Deploy").
WATCHED_WORKFLOWS=["Deploy"]
RERUN_ATTEMPTS=5

# --- IBM Bob Shell ---
# API key with "Inference" scope from the Bob web portal.
BOB_API_KEY=
# Only needed for general-type API keys.
BOB_TEAM_ID=
